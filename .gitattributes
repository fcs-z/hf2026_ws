* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Large and binary release artifacts are stored through Git LFS.
*.pt filter=lfs diff=lfs merge=lfs -text
runtime/wheels/*.whl filter=lfs diff=lfs merge=lfs -text
runtime/bin/uv filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
